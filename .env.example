# ============================================================
# Saúde RJ — variáveis de ambiente (cópia para .env e preencha)
# ============================================================

# --- Claude (Anthropic) ---
# A chave NUNCA deve ir ao frontend. Apenas o backend acessa Claude.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01

# --- Banco ---
DATABASE_URL=sqlite:///./data/saude.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth demo (token simples em memória) ---
AUTH_SECRET=demo-secret-trocar-em-producao
AUTH_TOKEN_TTL_MIN=480

# --- RAG / Embeddings (sentence-transformers local) ---
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./data/chroma

# --- STT (faster-whisper local) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
